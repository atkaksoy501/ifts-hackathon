# Runs on the Mac mini, where MongoDB and the UI app are reachable.
GITHUB_TOKEN=replace-with-github-token
GITHUB_REPOSITORY=atkaksoy501/ifts-hackathon
GITHUB_STATE_BRANCH=jira-live
GITHUB_STATE_PATH=jira-live/state.json
GITHUB_POLL_INTERVAL_SECONDS=3

# Current Docker MongoDB is auth-enabled. Use the local test password from the
# container/runtime secret source, not from the repository.
MONGO_URI=mongodb://admin:replace-with-password@localhost:27017/?authSource=admin
MONGO_DB=hackathon
MONGO_COLLECTION=jira_issues

APP_HOST=0.0.0.0
APP_PORT=8088
