# Runs on the company PC, where Jira is reachable.
JIRA_URL=https://jira.turkcell.com.tr
JIRA_AUTH_MODE=bearer
JIRA_TOKEN=replace-with-jira-token
JIRA_PROJECT_KEY=
JIRA_LIVE_JQL=updated >= -15m ORDER BY updated DESC
JIRA_POLL_INTERVAL_SECONDS=10

# Needs repo contents write permission. A fine-grained GitHub token scoped to
# atkaksoy501/ifts-hackathon Contents: Read and write is enough.
GITHUB_TOKEN=replace-with-github-token
GITHUB_REPOSITORY=atkaksoy501/ifts-hackathon
GITHUB_BASE_BRANCH=main
GITHUB_STATE_BRANCH=jira-live
GITHUB_STATE_PATH=jira-live/state.json
