# Copy this file to .env locally, then fill in the secret values.
# Never commit real tokens.

JIRA_URL=https://jira.turkcell.com.tr

# Turkcell Jira is likely Jira Data Center/Server. Personal access tokens usually
# use Bearer auth. If your token was created for Basic auth, set JIRA_AUTH_MODE=basic
# and also provide JIRA_USERNAME.
JIRA_AUTH_MODE=bearer
JIRA_TOKEN=replace-with-your-token
JIRA_USERNAME=

# Keep SSL verification enabled by default. If corporate CA validation fails,
# prefer setting JIRA_CA_BUNDLE to the PEM file instead of disabling verification.
JIRA_VERIFY_SSL=true
JIRA_CA_BUNDLE=

# Optional smoke-test defaults.
JIRA_PROJECT_KEY=
JIRA_SMOKE_JQL=project = DEMO ORDER BY updated DESC
